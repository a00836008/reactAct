        "func": "var tempHum = JSON.parse(msg.payload);\nvar vTemp = tempHum.t;\nvar vHum = tempHum.h;\nmsg.topic = \"INSERT INTO temperatura (temp) VALUES (\" + vTemp + \n \");INSERT INTO humedad (humedad) VALUES (\" + vHum + \");\";\nreturn msg;\n",
